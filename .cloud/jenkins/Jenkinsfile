// Runs `script` in the pinned Go toolchain instead of whatever the agent host
// has. Keep the image in sync with the service Dockerfiles and go.mod
// (go 1.27.4). Plain `docker run` rather than `agent { docker }`, which needs
// the Docker Pipeline plugin (up for adoption, deliberately not used). The
// container runs as the Jenkins uid; HOME and the Go caches live in the
// workspace's @tmp sibling. The CLI builds in go.work mode against the checked-out
// submodules, so GOWORK is left on.
def inGo(String script) {
    withEnv(["CI_SCRIPT=${script}"]) {
        sh '''
            mkdir -p "$WORKSPACE@tmp/ci-home"
            docker run --rm -u "$(id -u):$(id -g)" \\
                -v "$WORKSPACE:$WORKSPACE" -v "$WORKSPACE@tmp:$WORKSPACE@tmp" -w "$WORKSPACE" \\
                -e HOME="$WORKSPACE@tmp/ci-home" \\
                -e GOCACHE="$WORKSPACE@tmp/go-build" \\
                -e GOMODCACHE="$WORKSPACE@tmp/go-mod" \\
                -e GOTOOLCHAIN=local -e GOPRIVATE='github.com/CodeClarityCE/*' \\
                golang:1.27.4@sha256:5e8afd493a7124a8586e134d9b532731161d4b9becf9dee5a5956b107426f93d \\
                sh -ec "$CI_SCRIPT"
        '''
    }
}

pipeline {
    agent { label 'codeclarity' }

    options {
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Setup') {
            steps {
                // The workspace is reused across builds; sync first so a
                // changed .gitmodules URL replaces the one cached in .git/config,
                // and force the checkout so a clone left without a working tree
                // by an aborted build (HEAD already at the recorded commit) or
                // with stray edits is restored.
                sh 'git submodule sync --recursive && git submodule update --init --recursive --force'
            }
        }

        stage('Dependencies') {
            steps {
                inGo('go mod download')
                // Fail on an untidy go.mod/go.sum instead of rewriting it.
                inGo('go mod tidy -diff')
            }
        }

        stage('Lint') {
            steps {
                // Only the CLI module's own files: `gofmt -l .` would recurse
                // into the plugin/service/utility submodules, which are
                // checked by their own pipelines.
                inGo('test -z "$(gofmt -l main.go cmd internal)" || { gofmt -l main.go cmd internal; echo "Run gofmt -w on the files above"; exit 1; }')
                inGo('go vet ./...')
            }
        }

        stage('Test') {
            steps {
                inGo('go test -v ./...')
                inGo('go run golang.org/x/vuln/cmd/govulncheck@v1.8.0 ./...')
            }
        }

        stage('Build') {
            steps {
                inGo('go build -o bin/codeclarity .')
                echo "Build successful"
            }
        }
    }

    post {
        failure {
            echo "Build failed for CodeClarity CLI"
        }
    }
}
